{
  "name": "electron-airdrop",
  "version": "1.0.0",
  "description": "Desktop file sharing app like Airdrop",
  "main": "src/main.js",
  "homepage": "./",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "build": "electron-builder",
    "test": "node --test",
    "test:app": "node scripts/start.js --smoke"
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.yourname.airdrop",
    "productName": "AirDrop",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "AirDrop Installer"
    }
  }
}
